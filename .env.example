# ─────────────────────────────────────────────
# SUPABASE — Base de données et authentification
# ─────────────────────────────────────────────
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Variables SSR (nécessaires pour le build)
SUPABASE_URL=your_supabase_project_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key  # Optionnel — admin seulement

# ─────────────────────────────────────────────
# SUPABASE REALTIME — Notifications temps réel
# ─────────────────────────────────────────────
# Activer Realtime sur les tables concernées dans le dashboard Supabase :
# Database → Replication → enable "sales", "stock_movements", "products"
# Aucune variable d'env supplémentaire nécessaire — Supabase Realtime
# est intégré au client supabase-js.

# ─────────────────────────────────────────────
# RESEND — Envoi d'emails (factures, alertes stock)
# ─────────────────────────────────────────────
# VITE_RESEND_API_KEY=re_...

# ─────────────────────────────────────────────
# SENTRY — Monitoring des erreurs
# ─────────────────────────────────────────────
# DSN public (côté client)
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# DSN serveur (côté serveur)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Auth token pour l'upload des source maps (CI/CD)
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_RELEASE=indus-erp@1.0.0

# ─────────────────────────────────────────────
# LOGGING — Journalisation
# ─────────────────────────────────────────────
# Niveaux : debug, info, warn, error, fatal
# LOG_LEVEL=info

# ─────────────────────────────────────────────
# VERCEL — Déploiement (CI/CD)
# ─────────────────────────────────────────────
# VERCEL_TOKEN=your_vercel_token
# VERCEL_ORG_ID=your_org_id
# VERCEL_PROJECT_ID=your_project_id

# Secrets Vercel à configurer (dans Vercel Dashboard → Project Settings → Environment Variables) :
# - VITE_SUPABASE_URL
# - VITE_SUPABASE_PUBLISHABLE_KEY
# - SUPABASE_URL
# - SUPABASE_PUBLISHABLE_KEY # anon key (SSR)
